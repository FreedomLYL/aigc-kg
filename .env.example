# ===== 云端环境变量模板（Render / Railway / Zeabur 等）=====
# 必须：空库时自动恢复演示数据（9 门课程图谱 + teacher/student 演示账号）
SEED_ON_START=1

# 推荐：配置一个真实的 LLM Key，让云端提供真实的 AI 问答与图谱抽取；
# 不配也能运行（自动降级为演示模板，不报错）。

# -- DeepSeek（主）--
DEEPSEEK_API_KEY=sk-你的DeepSeek密钥
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat

# -- 豆包（备选，火山方舟）--
DOUBAO_API_KEY=ark-你的火山方舟Key
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=doubao-seed-1-6-250815

# 可选：接入云端 PostgreSQL 启用持久存储（否则用仓库自带 SQLite 演示库）
# DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require